{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppk.hangops.top/schema/catalog-v2.schema.json",
  "title": "PPK V2 Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "published_at", "providers", "models", "plans"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "release_id": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    },
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    },
    "plans": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "name_en", "website", "pricing_url", "region"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "name_en": {"type": "string", "minLength": 1},
        "website": {"type": "string"},
        "pricing_url": {"type": "string"},
        "region": {"type": "string"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "provider_id", "product_id", "status", "stale_fields", "freshness", "fields"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^[^/]+/.+$"},
        "provider_id": {"type": "string", "minLength": 1},
        "product_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["accepted", "partial", "stale", "review"]},
        "stale_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latest_observed_at", "oldest_observed_at", "lkg_age_hours", "manual_verified_at", "manual_expires_at", "manual_stale"],
          "properties": {
            "latest_observed_at": {"type": ["string", "null"]},
            "oldest_observed_at": {"type": ["string", "null"]},
            "lkg_age_hours": {"type": ["number", "null"], "minimum": 0},
            "manual_verified_at": {"type": ["string", "null"]},
            "manual_expires_at": {"type": ["string", "null"]},
            "manual_stale": {"type": "boolean"}
          }
        },
        "fields": {
          "type": "object",
          "required": ["name", "billing_type", "purchase_url"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "billing_type": {"enum": ["per_token", "subscription", "coding_plan"]},
            "purchase_url": {"type": "string"},
            "context_window": {"type": "integer", "minimum": 1},
            "modalities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "release_date": {"type": "string"},
            "plan_category": {"enum": ["general_ai", "coding_tool", "developer_api"]},
            "featured_on_home": {"type": "boolean"},
            "allowance": {
              "type": "object",
              "required": ["value", "unit"],
              "properties": {
                "value": {"type": ["number", "null"]},
                "unit": {"type": "string"}
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
