[Unit]
Description=PPK V2 pay-as-you-go data pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/llm-price-compare
ExecStart=/usr/bin/docker compose --profile pipeline run --rm pipeline-v2 run --profile payg
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
