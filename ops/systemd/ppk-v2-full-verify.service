[Unit]
Description=PPK V2 complete data verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/llm-price-compare
ExecStart=/usr/bin/docker compose --profile pipeline run --rm pipeline-v2 run --profile full-verify
TimeoutStartSec=60min
StandardOutput=journal
StandardError=journal
