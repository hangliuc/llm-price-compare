[Unit]
Description=PPK price data pipeline
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/llm-price-compare
ExecStart=/usr/bin/docker compose --profile pipeline run --rm pipeline run
TimeoutStartSec=45min

# Logs are available through journalctl -u ppk-data-pipeline.service.
StandardOutput=journal
StandardError=journal
